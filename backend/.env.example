# Copier ce fichier vers .env et renseigner les valeurs réelles (.env est ignoré par git).

# ── Obligatoire pour Moov'Coach /api/chat en local (npm run dev + dev-api Node)
OPENROUTER_API_KEY=sk-or-replace-me
LLM_MODEL=google/gemini-3-flash-preview
LLM_MAX_TOKENS=520
LLM_TEMPERATURE=0.25
JWT_SECRET=replace-me-with-32-bytes-random

ALLOWED_ORIGIN=http://localhost:5173,http://localhost:3000,http://VOTRE_IP_VPS:5173
HF_TOKEN=hf_replace-me
DATABASE_URL=sqlite:////app/db/moovup.db
DATA_DIR=/app/data
